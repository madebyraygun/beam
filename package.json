{
  "name": "@placeholder/shared-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Theme tokens and the application shell (frame, sidebar, breadcrumb, status line, toast, icons) as Lit components",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./theme.css": "./dist/css/nigel.css",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.preview.ts",
    "!src/**/__tests__",
    "!src/**/__mocks__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "demo": "vite --config preview/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src preview theme-tests",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": "^3.1.0",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.1.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.2",
    "axe-core": "^4.10.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^27.4.0",
    "lit": "^3.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
